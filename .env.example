# Eisman Holdings Command Center — environment
#
# Copy to .env.local and fill in what you need. NOTHING here is required to run
# the system locally: with no configuration it uses an embedded Postgres and a
# development key. Every value below is required only for the feature it names.
#
# Never commit .env.local. Never paste a real secret into chat or a ticket.

# ---------------------------------------------------------------- essentials

# Signs session tokens. Required in production; generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Postgres connection string. Leave empty to use the embedded database in
# .data/pglite, which needs no installation and is fine for local work.
#   postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Encrypts stored integration credentials (AES-256-GCM). Required in
# production. Exactly 32 bytes, base64-encoded:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# How long a sign-in lasts.
SESSION_TTL_HOURS=168

# Sign-in attempt budgets per fifteen minutes. Raise only for an automated
# test run against a throwaway database.
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPTS_PER_EMAIL=8

# ---------------------------------------------------------------- demo data

# Whether demo data and Demo Mode for integrations are offered at all.
DEMO_MODE=true

# Set to true on production. Blocks the demo seed, the demo reset, and Demo
# Mode, so sample records can never reach real data.
DISABLE_DEMO_DATA=false

# ------------------------------------------------------------- integrations
#
# Every one of these is optional. Without them the matching integration shows
# as Disconnected, which is the truth. Credentials can also be entered in the
# interface instead, where they are encrypted at rest; the environment is the
# better place for a server deployment.

# ClickUp — a personal API token from Settings → Apps, and the team id from
# the URL of your workspace (app.clickup.com/<team id>/...).
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Stripe — use a RESTRICTED key, read-only, for Charges, Customers, Invoices,
# Subscriptions and Products. Never a full secret key.
STRIPE_SECRET_KEY=

# Google Calendar — OAuth client from Google Cloud Console, with the Calendar
# API enabled. No Google password is ever stored or requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gusto — an access token for their API, and the company id. Used for headcount
# and payroll totals only; no social security numbers or bank details are read.
GUSTO_ACCESS_TOKEN=
GUSTO_COMPANY_ID=

# ParFax — the base URL and key for whichever system is ParFax's real source of
# record. Read-only until write-back is explicitly enabled in the interface.
PARFAX_API_BASE=
PARFAX_API_KEY=

# Anthropic — enables generated summaries and answers in the Knowledge Hub.
# Without it a local extractive provider is used, which quotes source text and
# cannot invent anything.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_PROVIDER=local

# ---------------------------------------------------------------- operations

# Shared secret for the scheduled-sync endpoint, if you run one.
CRON_SECRET=

LOG_LEVEL=info
