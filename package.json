{
  "name": "eisman-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "Eisman Holdings Command Center \u2014 the web application, the mobile application, and the code they share.",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @eisman/web",
    "build": "npm run build --workspace @eisman/web",
    "start": "npm run start --workspace @eisman/web",
    "mobile": "npm run start --workspace @eisman/mobile",
    "db:migrate": "npm run db:migrate --workspace @eisman/web",
    "db:seed": "npm run db:seed --workspace @eisman/web",
    "db:reset-demo": "npm run db:reset-demo --workspace @eisman/web",
    "db:nuke": "npm run db:nuke --workspace @eisman/web",
    "setup": "npm run setup --workspace @eisman/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @eisman/web",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "decode-uri-component": "^0.4.1"
  }
}
