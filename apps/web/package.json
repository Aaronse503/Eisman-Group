{
  "name": "@eisman/web",
  "version": "1.0.0",
  "private": true,
  "description": "Eisman Holdings Command Center \u2014 internal multi-company business operating system.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-demo": "tsx scripts/reset-demo.ts",
    "db:nuke": "rimraf .data/pglite",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "e2e:server": "bash scripts/dev/e2e-server.sh",
    "check:deploy": "tsx scripts/check-deploy.ts"
  },
  "dependencies": {
